# Plantilla de /opt/asistente-blockchain/.env en la VM (600, del usuario asistente). Sin secretos en el repo:
# instalar.sh pide LLM_API_KEY sin mostrarla y copia el resto de esta plantilla tal cual.
# La leen systemd (EnvironmentFile=) y la app (backend/app.py, leer_env). Formato KEY=valor, sin comillas.

# Clave de la API de Claude (platform.claude.com). Vacía = el widget anda sin IA (ruteo por palabras clave).
LLM_API_KEY=
# Nunca 1 en producción: con 1 la app sirve el sitio entero e inyecta el widget (solo desarrollo).
DEV=0

# Dirección de origen para los topes: X-Real-IP solo se cree si la conexión viene de acá (nginx en la misma VM).
# (También está como Environment= en la unidad de systemd.)
PROXIES_CONFIABLES=127.0.0.1

# Medición anónima del embudo (POST /blockchain-dev/api/m). 0 = apagada.
MEDICION=1

# --- Cadena real (backend/cadena.py). Mismos nombres que .env.example; una CADENA_* desconocida se avisa al arrancar.
# simulado (por defecto: /api/cadena/* responde 409 y el widget usa su cadena del navegador) | real
CADENA_MODO=simulado
# RPC del proveedor para Base Sepolia (sale por el proxy de la UNLu)
CADENA_RPC=
# 84532 = Base Sepolia
CADENA_CHAIN_ID=84532
# Salida del despliegue (contratos/deploy/84532.json copiado a la VM)
CADENA_DEPLOY=/opt/asistente-blockchain/contratos/deploy/84532.json
# Firma del relayer: rutas, nunca el valor. Con LoadCredential= en la unidad quedan en
# /run/credentials/asistente-blockchain.service/ (solo este proceso las lee).
CADENA_KEYSTORE=/run/credentials/asistente-blockchain.service/keystore
CADENA_KEYSTORE_CLAVE_ARCHIVO=/run/credentials/asistente-blockchain.service/keystore-clave
# Explorador (por defecto Blockscout de Base Sepolia en 84532)
# CADENA_EXPLORADOR=https://base-sepolia.blockscout.com
# Topes: tx por día por origen, tx por día en total, saldo mínimo del relayer (por debajo: 503 sin_fondos) y pedidos
# a /cadena/* por minuto y por día por origen (con o sin tx)
# CADENA_TX_POR_ORIGEN=40
# CADENA_TX_POR_DIA=600
# CADENA_MIN_ETH=0.0005
# CADENA_PEDIDOS_POR_MINUTO=20
# CADENA_PEDIDOS_POR_ORIGEN=300
