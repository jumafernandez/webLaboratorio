# Clave de la API de Anthropic (no se versiona)
LLM_API_KEY=
# 1 = sirve también el sitio estático con el widget inyectado (solo desarrollo)
DEV=1
# Carpeta del sitio (por defecto la raíz de este repo, dos niveles arriba)
# SITIO_DIR=

# ---------- Medición anónima del embudo (POST /blockchain-dev/api/m) ----------
# 0 = apagada: el endpoint responde 204 sin guardar y /estado avisa "medicion": false
# MEDICION=1

# ---------- Cadena real (backend/cadena.py, /blockchain-dev/api/cadena/*) ----------
# simulado (por defecto: todo responde 409 y el widget usa su cadena simulada) | real
CADENA_MODO=simulado
# RPC del nodo (Anvil local: http://127.0.0.1:8545; Base Sepolia: el de tu proveedor)
CADENA_RPC=
# 31337 = Anvil, 84532 = Base Sepolia
CADENA_CHAIN_ID=
# Salida del despliegue: contratos/deploy/<chainid>.json
CADENA_DEPLOY=
# Firma del relayer en una red pública: keystore cifrado + archivo con su contraseña (rutas, nunca el valor acá)
CADENA_KEYSTORE=
CADENA_KEYSTORE_CLAVE_ARCHIVO=
# Solo Anvil (31337): clave de la cuenta de desarrollo pública #0. En cualquier otra red se rechaza.
CADENA_CLAVE_DEV=
# Explorador (por defecto Blockscout de Base Sepolia en 84532 y ninguno en Anvil)
# CADENA_EXPLORADOR=
# Topes: tx por día por origen, tx por día en total, y saldo mínimo del relayer (por debajo: 503 sin_fondos)
# CADENA_TX_POR_ORIGEN=40
# CADENA_TX_POR_DIA=600
# CADENA_MIN_ETH=0.0005
# Pedidos a /cadena/* por origen (con o sin tx): por minuto y por día
# CADENA_PEDIDOS_POR_MINUTO=20
# CADENA_PEDIDOS_POR_ORIGEN=300

# ---------- Origen de los pedidos (topes) ----------
# X-Real-IP solo se cree si la conexión viene de uno de estos (separados por coma). Vacío en desarrollo; en producción
# 127.0.0.1 (nginx en la misma VM, que pisa el encabezado con $remote_addr).
# PROXIES_CONFIABLES=
